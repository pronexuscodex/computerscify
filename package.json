{
  "name": "computerscify",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based, first-principles computer science and data science learning platform.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run pyodide:copy",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run pyodide:copy",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "npm run pyodide:copy",
    "pyodide:copy": "node scripts/copy-pyodide-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "tsx scripts/test-runner.ts",
    "test:ide": "tsx scripts/ide-runner-smoke.ts",
    "resources:verify": "tsx scripts/verify-academic-resources.ts",
    "resources:verify:pdf": "tsx scripts/verify-pdf-rendering.ts",
    "resources:verify:papers": "tsx scripts/verify-paper-metadata.ts",
    "resources:report": "tsx scripts/verify-academic-resources.ts --report",
    "topics:verify-resources": "tsx scripts/verify-topic-resources.ts",
    "topics:verify-resources:changed": "tsx scripts/verify-topic-resources.ts --changed",
    "topics:resource-report": "tsx scripts/verify-topic-resources.ts --report",
    "curriculum:validate": "tsx scripts/validate-curriculum.ts",
    "curriculum:validate:cs": "tsx scripts/validate-curriculum.ts --cs",
    "curriculum:validate:ds": "tsx scripts/validate-curriculum.ts --ds",
    "concepts:validate": "tsx scripts/validate-concepts.ts",
    "videos:verify": "tsx scripts/verify-video-resources.ts",
    "videos:verify:changed": "tsx scripts/verify-video-resources.ts --changed",
    "videos:report": "tsx scripts/verify-video-resources.ts --report",
    "validate": "npm run typecheck && npm run test && npm run curriculum:validate && npm run resources:verify && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "prismjs": "^1.30.0",
    "pyodide": "^0.25.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "netlify-cli": "^27.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
